generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Una pieza terminada, lista para vender. `stock` son unidades reales que
/// María tiene en la mano: si llega a 0 la pieza se muestra como agotada.
model Producto {
  id        String @id @default(cuid())
  slug      String @unique
  nombre    String
  /// PULSERA | COLGADOR | COLLAR | CARTERA — ver src/lib/categorias.ts
  categoria String

  descripcion String?
  /// Texto libre: "Perlas 10 mm marfil, cuentas 6 mm rosa, dijes dorados".
  materiales  String?
  color       String?

  // --- Medidas (en cm salvo cuentaMm). Cada categoría usa las suyas. ---
  /// Pulsera, collar y colgador: largo total.
  largoCm       Float?
  /// Cartera: ancho.
  anchoCm       Float?
  /// Cartera: alto.
  altoCm        Float?
  /// Cartera: profundidad.
  profundidadCm Float?
  /// Diámetro de la cuenta principal, en mm.
  cuentaMm      Float?
  /// Pulsera con extensión regulable.
  ajustable     Boolean @default(false)
  /// Cuántos cm suma la extensión.
  extensionCm   Float?

  // --- Plata ---
  /// Lo que le cuesta a María hacerla. Interno: nunca sale al cliente.
  costo  Float @default(0)
  /// Lo que paga el cliente.
  precio Float @default(0)

  // --- Estado ---
  /// Unidades disponibles.
  stock     Int     @default(0)
  destacado Boolean @default(false)
  /// Si está en false, no aparece en la tienda.
  publicado Boolean @default(true)
  /// Nota interna: proveedor, lote, dónde está guardada. No sale al cliente.
  notaInterna String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  fotos  Foto[]
  patron PatronCartera?

  @@index([categoria])
  @@index([publicado])
}

/// Fotos de una pieza. Se guardan en public/uploads y acá va la ruta.
model Foto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  orden      Int      @default(0)

  @@index([productoId])
}

/// El patrón 3D de una cartera: sus medidas, su paleta y el color de cada
/// cuenta. `celdas` es un caracter base36 por cuenta, en el orden en que
/// `armarLayout()` genera la lista (ver src/lib/cartera/geometria.ts).
/// Cuenta o insumo disponible para tejer. Este es el inventario que alimenta
/// las opciones de color y tamaño del diseñador de carteras y del diseñador
/// del cliente (`/disenar`).
model CuentaStock {
  id            String   @id @default(cuid())
  nombre        String
  color         String
  tamanoMm      Float
  acabado       String   @default("perla")
  /// Lo que paga el cliente por cada cuenta en el diseñador. 0 = todavía sin precio.
  precioUnidad  Float    @default(0)
  stock         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activo])
}

/// Dije o colgante disponible como insumo. Se guarda aparte de las cuentas
/// porque no participa en la paleta ni en el conteo de tejido.
model DijeStock {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  imagenUrl     String?
  stock         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activo])
}

/// Pedido enviado por la tienda. El stock se confirma manualmente para no
/// reservar una pieza artesanal hasta hablar con la clienta.
model Pedido {
  id          String   @id
  codigo      String   @unique
  nombre      String
  contacto    String
  nota        String?
  total       Float
  lineas      String
  estado      String   @default("PENDIENTE")
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado])
  @@index([creadoEn])
}

/// Ajustes únicos de la vendedora, editables desde el panel protegido.
model ConfiguracionVendedora {
  id            String   @id
  whatsapp      String
  actualizadoEn DateTime @updatedAt
}

model PatronCartera {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String
  /// Ficha de `carteras diseños/` de la que salió, si viene de una.
  ficha  String?

  /// caja | corazon | tulipan | fresa | cuadrada — con qué forma se arma. Ver src/lib/cartera/geometria.ts
  forma         String @default("caja")
  anchoCm       Float
  altoCm        Float
  profundidadCm Float
  altoSolapaCm  Float
  asaCm         Float
  /// Diámetro del aro de acero de las esquinas de arriba. Solo forma "cuadrada".
  aroCm         Float?
  /// Largo de la cadena, de aro a aro. Solo forma "cuadrada".
  cadenaCm      Float?
  cuentaMm      Float
  separacion    Float @default(1.3)
  /// Color del forro en el visor 3D. Cada cartera conserva el suyo.
  forroColor    String @default("#e8a6b8")

  /// JSON con la paleta: [{ mm, color, nombre, acabado }]
  paleta String
  /// Un caracter base36 por cuenta.
  celdas String

  /// La pieza del catálogo que este patrón representa, si ya está cargada.
  productoId String?   @unique
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// Un hilo de cuentas que armó un cliente en `/disenar`: pulsera, collar o
/// colgador. `celdas` es un caracter base36 por cuenta —mismo formato que
/// `PatronCartera.celdas`— en el orden del hilo, arrancando desde el cierre.
///
/// La paleta se guarda **copiada** adentro del diseño, no referenciada: si
/// María borra una cuenta del inventario o le cambia el precio, el diseño que
/// el cliente ya mandó tiene que seguir viéndose igual.
/// Una cartera que personalizó un cliente en `/disenar/cartera`: eligió una
/// llana, un estampado y los colores. **No guarda el mapa de tejido**: el
/// cliente elige, María teje.
model DisenoCartera {
  id     String @id @default(cuid())
  /// Seis caracteres. Es el link que se manda: /disenar/cartera/ver/ABC123
  codigo String @unique

  /// Slugs de src/lib/cartera/llanas.ts y estampados.ts
  llana     String
  estampado String
  nombre    String

  /// JSON con la paleta, **copiada**: el diseño tiene que verse igual aunque
  /// María borre esa cuenta del inventario.
  paleta String
  /// JSON con las medidas, por lo mismo.
  medidas String
  celdas  String

  /// Calculado en el servidor con los precios del inventario. Es estimado.
  precio Float @default(0)

  /// Datos que dejó el cliente, si los dejó. Solo los ve María.
  contacto String?
  nota     String?

  creadoEn DateTime @default(now())

  @@index([creadoEn])
}

model DisenoCliente {
  id     String @id @default(cuid())
  /// Seis caracteres. Es el link que se manda por WhatsApp: /disenar/ver/ABC123
  codigo String @unique
  /// PULSERA | COLLAR | COLGADOR — ver src/lib/hilo/tipos.ts
  tipo   String
  nombre String

  /// JSON: [{ id, nombre, color, mm, acabado, precioUnidad }]
  paleta String
  celdas String

  /// Largo que pidió el cliente, en cm. El real sale de sumar las cuentas.
  largoObjetivoCm Float
  /// Largo y precio calculados en el servidor al guardar.
  largoCm Float
  precio  Float @default(0)

  /// Datos que dejó el cliente, si los dejó. Solo los ve María.
  contacto String?
  nota     String?

  creadoEn DateTime @default(now())

  @@index([creadoEn])
}
